{
  "manifest_version": 3,
  "name": "OpenCanvas",
  "version": "0.1.0",
  "description": "Dark mode and custom color palettes for your school's Canvas site.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "OpenCanvas",
    "default_popup": "popup/popup.html"
  }
}
